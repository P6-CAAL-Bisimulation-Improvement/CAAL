{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug in Chrome",
            "url": "http://localhost:8090",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "../src/*": "${workspaceFolder}/src/*"
            }
        },
        {
            "type": "firefox",
            "request": "launch",
            "name": "Launch Firefox",
            "url": "http://localhost:8090",
            "webRoot": "${workspaceFolder}",
        },
        {
            "type": "node",
            "request": "launch",
            "name": "QUnit Tests",
            "program": "${workspaceFolder}/node_modules/.bin/qunit",
            "args": [
                "--require",
                "./test/bootstrap.js",
                "test/integration/*.js"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}